# ========================================================
# RENDER BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# (Configure these in Render Dashboard -> Web Service -> Environment)
# ========================================================

# Deployment Environment
NODE_ENV=production

# Server Port (Render automatically supplies PORT, default 5000)
PORT=5000

# MongoDB Atlas Connection URI (REQUIRED in production)
# Format: mongodb+srv://<USERNAME>:<PASSWORD>@<CLUSTER>.mongodb.net/<DATABASE>?retryWrites=true&w=majority
# IMPORTANT:
# - Do NOT hardcode credentials in source code.
# - Do NOT use localhost or 127.0.0.1 in production.
# - Specify your target database name (e.g., company_platform or test)
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/company_platform?retryWrites=true&w=majority

# JWT Token Secret (REQUIRED - Strong random secret for production)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_for_production
JWT_EXPIRES_IN=24h

# Frontend Origin for CORS & Redirection (REQUIRED)
CORS_ORIGIN=https://break-fast-management.vercel.app
CLIENT_URL=https://break-fast-management.vercel.app

# Application Timezone Engine (Asia/Kolkata for Breakfast Management)
TIMEZONE=Asia/Kolkata


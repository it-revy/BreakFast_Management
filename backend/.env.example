# ========================================================
# RENDER BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# (Set these in Render Web Service Dashboard -> Environment)
# ========================================================

# Deployment Environment ('staging' or 'production')
NODE_ENV=production

# Server Port (Render dynamically assigns PORT)
PORT=5000

# MongoDB Atlas Connection URI
# Staging: mongodb+srv://<staging-app-user>:<staging-password>@<cluster>.mongodb.net/REVY-BREAKFAST-STAGING?retryWrites=true&w=majority
# Production: mongodb+srv://<prod-app-user>:<prod-password>@<cluster>.mongodb.net/REVY-BREAKFAST-PRODUCTION?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.g3lap1h.mongodb.net/REVY-BREAKFAST-STAGING?retryWrites=true&w=majority

# JWT Token Secret (Use strong 64+ char random string)
JWT_SECRET=your_super_strong_random_jwt_secret_render_production_key_here
JWT_EXPIRES_IN=24h

# Allowed Vercel Frontend Origin (Exact URL, No trailing slash)
FRONTEND_URL=https://revy-breakfast.vercel.app

# Optional: Set to 'true' in staging if preview deployments (*.vercel.app) need API access
ALLOW_VERCEL_PREVIEWS=false

# Timezone
TIMEZONE=Asia/Kolkata
